# Core
PORT=8080
NODE_ENV=production
DATABASE_URL=postgresql://myrailway:change-me@postgres:5432/myrailway
REDIS_URL=redis://redis:6379
SESSION_SECRET=replace-with-at-least-32-random-characters
# 32 random bytes, base64 encoded: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=replace-with-base64-32-byte-key
ADMIN_BOOTSTRAP_PASSWORD=

# GitHub
GITHUB_WEBHOOK_SECRET=replace-me
# For private repositories in v1. Prefer a GitHub App token in production.
GITHUB_TOKEN=

# Runtime/agent
AGENT_TOKEN=replace-with-long-random-token
CONTROL_PLANE_URL=http://control:8080
SERVER_ID=local-runtime-01
SERVER_NAME=Local Runtime 01
REGISTRY_URL=registry:5000
PLATFORM_NETWORK=myrailway
TRAEFIK_ROUTES_DIR=/var/lib/myrailway/routes
BACKUP_DIR=/var/lib/myrailway/backups
PUBLIC_IP=
PLATFORM_HOST=
DEPLOY_GRACE_SECONDS=10
DEPLOY_HEALTH_RETRIES=24
DEPLOY_HEALTH_INTERVAL_MS=2500
AUTO_MIGRATE=true

# Traefik / ACME
ACME_EMAIL=admin@example.com
